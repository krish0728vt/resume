---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length] }
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const num = (o: number) => `05.${String(o).padStart(2, '0')}`;
const statusCls = d.status === 'Completed' ? 'done' : 'wip';
---
<Base title={`${d.title} — Krish Ankur Shah`} description={d.summary} image={d.model ? `og/${entry.id}.jpg` : d.cover ?? 'Profile.jpg'}>

  {d.model ? (
    <section class="pv" data-model={`${base}models/${d.model}`} data-parts={JSON.stringify(d.parts)} data-sheet="05" data-title={d.short}>
      <div class="pv-pin">
        <div class="pv-stage" role="group" aria-label={`3D exploded view of ${d.title}. Drag to rotate.`}>
          <svg aria-hidden="true"></svg>
          <div class="pv-tags"></div>
        </div>
        <div class="pv-fit" aria-hidden="true"></div>
        <div class="pv-text">
          <div class="pv-intro">
            <div class="kicker mono fade" style="--d:.15s"><a href={`${base}#projects`} style="text-decoration:none">← Register</a> · Dwg {num(d.order)}{d.status && <> · <span class={`status ${statusCls}`}>{d.status}</span></>}</div>
            <h1 class="pv-title"><span class="ln"><span style="--d:.1s">{d.title}</span></span></h1>
            <p class="pv-sum fade" style="--d:.4s">{d.summary}</p>
            <ul class="chips fade" style="--d:.5s">{d.stack.map(s => <li>{s}</li>)}</ul>
          </div>
          <div class="pv-plist">
            <div class="mono" style="color:var(--ink-2)">Fig. {num(d.order).replace(/^0/, '')} — Parts list</div>
            <h2>{d.short} <em>exploded</em></h2>
            <table class="parts"><thead><tr><th>Item</th><th>Part</th><th>Description</th><th>Qty</th></tr></thead><tbody></tbody></table>
            <p class="pv-legend"></p>
            <div class="pv-tip mono">Click a number or a row to inspect that part</div>
          </div>
        </div>
        <div class="pv-insp" role="region" aria-label="Part inspector" aria-live="polite">
          <div class="pi-head mono"><span class="pi-item"></span><button type="button" class="pi-close" aria-label="Close inspector">Close ✕</button></div>
          <div class="pi-name"></div>
          <p class="pi-desc"></p>
          <div class="pi-foot mono"><span class="pi-qty"></span><span class="pi-nav"><button type="button" class="pi-prev" aria-label="Previous part">← Prev</button><button type="button" class="pi-next" aria-label="Next part">Next →</button></span></div>
          <div class="pi-hint mono">Drag to rotate · Click the part or Esc to go back</div>
        </div>
        <div class="pv-foot">
          <div class="pv-cuewrap mono fade" style="--d:.8s"><span class="pv-cue">Scroll to disassemble</span><span class="pv-meter"><i></i></span><span class="pv-pct">000%</span></div>
          <div class="figcap fade" style="--d:.9s"><b>Fig. {num(d.order).replace(/^0/, '')}</b> — {d.figure} Drag to rotate.</div>
        </div>
      </div>
    </section>
  ) : (
    <section class={`phead${d.cover ? ' has-cover' : ''}`} data-sheet="05" data-title={d.short}>
      <div class="wrap phead-grid">
        <div>
        <div class="kicker mono fade" style="--d:.15s"><a href={`${base}#projects`} style="text-decoration:none">← Register</a> · Dwg {num(d.order)}</div>
        <h1 class="pv-title"><span class="ln"><span style="--d:.1s">{d.title}</span></span></h1>
        <p class="pv-sum fade" style="--d:.4s">{d.summary}</p>
        <ul class="chips fade" style="--d:.5s">{d.stack.map(s => <li>{s}</li>)}</ul>
        </div>
        {d.cover && (
          <figure class="portrait fade" style="--d:.3s">
            <div class="img" style="aspect-ratio:4/3"><img src={`${base}${d.cover}`} alt={d.title} style="object-position:50% 50%" /></div>
            <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
            <figcaption class="mono"><span>Fig. {num(d.order).replace(/^0/, '')}</span><span>{d.gallery[0]?.caption}</span></figcaption>
          </figure>
        )}
      </div>
    </section>
  )}

  <div class="wrap">
    <div class="pbody">
      <aside class="meta rv">
        <dl>
          <div><dt>Drawing</dt><dd>{num(d.order)} · Rev B</dd></div>
          <div><dt>Discipline</dt><dd>{d.discipline}</dd></div>
          {d.status && <div><dt>Status</dt><dd><span class={`status ${statusCls}`}>{d.status}</span></dd></div>}
          <div><dt>Stack</dt><dd><ul>{d.stack.map(s => <li>{s}</li>)}</ul></dd></div>
        </dl>
      </aside>
      <article class="prose rv">
        <Content />
      </article>
    </div>

    {d.video && (
      <>
        <div class="ruler" style="margin-top:60px"></div>
        <div class="sheet-head mono"><span>Film</span><span>{d.video.caption}</span></div>
        <figure class="film rv">
          <video src={`${base}${d.video.src}`} poster={`${base}${d.video.poster}`} muted loop playsinline preload="none" controls data-autoplay></video>
        </figure>
      </>
    )}

    {d.gallery.length > 0 && (
      <>
        <div class="ruler" style="margin-top:60px"></div>
        <div class="sheet-head mono"><span>Photographs</span><span>{d.gallery.length} views</span></div>
        <div class="gallery">
          {d.gallery.map((g, i) => (
            <figure class="rv" style={`--d:${(i % 3) * 0.08}s`}>
              <a href={`${base}${g.src}`} data-caption={g.caption}><img src={`${base}${g.src}`} alt={g.caption} loading="lazy" /></a>
              <figcaption class="mono"><span>View {String.fromCharCode(65 + i)}</span><span>{g.caption}</span></figcaption>
            </figure>
          ))}
        </div>
        <figure class="lightbox" aria-hidden="true" role="dialog" aria-label="Photo viewer" tabindex="-1"><img alt="" /><figcaption class="mono"></figcaption></figure>
      </>
    )}

    <nav class="pnav" aria-label="More projects">
      <a href={`${base}projects/${prev.id}/`}><small class="mono">← Dwg {num(prev.data.order)}</small><span>{prev.data.title}</span></a>
      <a href={`${base}projects/${next.id}/`}><small class="mono">Dwg {num(next.data.order)} →</small><span>{next.data.title}</span></a>
    </nav>
  </div>

  <script>
    const el = document.querySelector<HTMLElement>('.pv');
    if (el) import('../../scripts/project-viewer.ts').then(m => m.mountProjectViewer(el));
  </script>
</Base>
