---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Sheet not found — Krish Ankur Shah" description="This drawing sheet does not exist." noindex>
  <section class="phead" data-sheet="00" data-title="Not found">
    <div class="wrap">
      <div class="kicker mono">Error 404 · Sheet missing from the set</div>
      <h1 class="pv-title">This sheet isn't in <em>the drawing set.</em></h1>
      <div class="actions"><a class="tlink" href={base}>Back to the title sheet <span class="ar">→</span></a></div>
    </div>
  </section>
</Base>
